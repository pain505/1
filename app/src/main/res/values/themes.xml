<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 只用平台 Material 主题，不依赖 MaterialComponents -->
    <style name="Theme.PickupCode" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg_page</item>
    </style>

    <!-- 权限提示行：整行可点 -->
    <style name="PermissionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/permission_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/permission_text</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
